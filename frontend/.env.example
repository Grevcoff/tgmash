# API URL
# Локальная разработка:
VITE_API_URL=http://localhost:8000/api

# Продакшен (Koyeb):
# VITE_API_URL=https://mushroom-bot.koyeb.app/api

# Fallback для production-сборки (если VITE_API_URL не задан)
VITE_API_URL_FALLBACK=/api

# Telegram Bot Token (только для разработки)
# VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here

# Режим отладки
VITE_DEBUG=false
