# Telegram Bot Token (из @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database (Supabase PostgreSQL - Transaction Pooler)
# Формат: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0.[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.xxx:password@aws-0.eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# App settings
DEBUG=false
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# CORS: домены фронтенда через запятую, без пробелов
CORS_ORIGINS=https://mushroom-bot.vercel.app,https://mushroom-bot-git-main.vercel.app,http://localhost:5173

# Koyeb: порт задаётся платформой, но можно указать дефолт
PORT=8080
